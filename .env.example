# Use a read-only token. Never commit a real token.
TBANK_API_TOKEN=
# TBANK_APP_NAME=tbank
# TBANK_TLS_CA_FILE=

# scan requires an explicit endpoint and an existing account ID.
# It records paper positions only; it never places broker orders.
# Production validates entry commission previews for this account:
# TBANK_ENDPOINT=invest-public-api.tbank.ru:443
# TBANK_ACCOUNT_ID=your_production_broker_account_id

# Or use sandbox: shared market data, hypothetical fees without broker preview.
# Its paper positions use a separate database with a .sandbox suffix.
# TBANK_ENDPOINT=sandbox-invest-public-api.tbank.ru:443
# TBANK_ACCOUNT_ID=your_existing_sandbox_account_id

# Only required for scan -notify (fixture mode rejects -notify):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
